# Required: Discord Developer Portal > Bot > Token
DISCORD_TOKEN=replace_with_your_bot_token

# Recommended while developing: Discord server ID for instant command updates.
DEV_GUILD_ID=

# Optional: enables AI-generated article summaries. Keep this secret.
OPENAI_API_KEY=
# Optional: defaults to gpt-5.6.
OPENAI_MODEL=gpt-5.6
